{
  "name": "dsh-openspec-baton",
  "version": "0.3.1",
  "description": "Deterministic ticket/DAG/subagent control plane over OpenSpec changes: one DSH bundle mounts the baton skill; the deterministic controller is driven through a local Python CLI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/",
    "scripts/",
    "templates/",
    "docs/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumos-789/baton"
  },
  "keywords": [
    "dsh-plugin",
    "openspec",
    "subagents",
    "ticket-dag",
    "workflow"
  ]
}
